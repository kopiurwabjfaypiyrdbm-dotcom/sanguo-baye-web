{
  "name": "sanguo-baye-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "build": "tsc -b && vite build",
    "test": "vitest run --pool=threads --maxWorkers=1 --minWorkers=1",
    "godot:spike-data": "vite-node scripts/generate-godot-spike-data.ts",
    "godot:migration-fixtures:check": "vite-node scripts/verify-godot-migration-fixtures.ts",
    "godot:migration-check": "npm run godot:migration-fixtures:check && node scripts/run-godot-migration-verification.mjs",
    "godot:domain-data:generate": "vite-node scripts/generate-godot-domain-data.ts --write",
    "godot:domain-data:check": "vite-node scripts/generate-godot-domain-data.ts",
    "godot:domain-data:verify": "npm run godot:domain-data:check && node scripts/run-godot-domain-data-verification.mjs",
    "godot:application-session:generate": "vite-node scripts/generate-godot-application-session-fixture.ts --write",
    "godot:application-session:check": "vite-node scripts/generate-godot-application-session-fixture.ts",
    "godot:application-session:verify": "npm run godot:application-session:check && node scripts/run-godot-application-session-verification.mjs",
    "godot:tactical-battle:generate": "vite-node scripts/generate-godot-tactical-battle-fixture.ts --write",
    "godot:tactical-battle:check": "vite-node scripts/generate-godot-tactical-battle-fixture.ts",
    "godot:tactical-battle:verify": "npm run godot:tactical-battle:check && node scripts/run-godot-tactical-battle-verification.mjs",
    "godot:project:verify": "node scripts/run-godot-project-verification.mjs",
    "godot:program-check": "node scripts/verify-godot-program.mjs --self-test --recover",
    "icons:generate": "node scripts/generate-app-icons.mjs",
    "android:add": "npm run build && cap add android",
    "android:sync": "npm run build && cap sync android",
    "android:assets": "node scripts/generate-android-assets.mjs",
    "android:doctor": "cap doctor android",
    "android:apk": "npm run android:sync && node scripts/build-android-debug.mjs",
    "android:open": "cap open android",
    "android:run": "npm run android:sync && cap run android",
    "reference:setup": "node scripts/fetch-baye-reference.mjs",
    "reference:setup:full": "node scripts/fetch-baye-reference.mjs --full-source",
    "reference:setup:offline": "node scripts/fetch-baye-reference.mjs --full-source --include-offline-runtime",
    "reference:sync-core": "node scripts/sync-baye-core-reference.mjs",
    "reference:check": "node scripts/verify-baye-core-reference.mjs",
    "check": "npm run godot:program-check && npm run godot:domain-data:check && npm run godot:application-session:check && npm run godot:tactical-battle:verify && npm run reference:check && npm test && npm run build"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "phaser": "^3.90.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "sharp": "^0.35.3",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^2.1.0"
  }
}
